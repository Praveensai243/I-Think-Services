# ────────────────────────────────────────────────────────────────
#  I Think Services — AI agent backend configuration
#  Copy this file to `.env` and fill in what you have. Nothing here is
#  required to run the browser demo in DEMO MODE (mock calendar), except
#  ANTHROPIC_API_KEY once you want the agent to actually think/talk.
# ────────────────────────────────────────────────────────────────

# ---- The brain (required for real replies) ----------------------
# Get a key at https://console.anthropic.com  ("API Keys")
ANTHROPIC_API_KEY=

# Model for the conversation brain. Default is claude-opus-5.
# For the LOWEST latency on live phone calls, set MODEL=claude-haiku-4-5.
MODEL=claude-opus-5

# ---- Server ----------------------------------------------------
PORT=8787
# Public base URL of THIS server once deployed (used in the Vapi assistant
# config it serves). e.g. https://agent.ithinkservices.net
PUBLIC_BASE_URL=http://localhost:8787

# ---- Booking backend -------------------------------------------
# CALENDAR=mock   -> keyless in-memory calendar (great for the demo)
# CALENDAR=google -> real Google Calendar (needs the Google vars below)
# CALENDAR=calcom -> Cal.com (needs CALCOM_* below)
CALENDAR=mock

# Google Calendar (only when CALENDAR=google). Two ways to authenticate —
# set EITHER the service-account key OR the OAuth trio. See README §3.
#
# Recommended: a service account. Share your calendar with its client_email
# ("Make changes to events"), then paste the JSON key here — base64-encoded is
# safest, since most dashboards mangle multi-line values.
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Fallback: OAuth refresh token for the account that owns the calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2/callback
GOOGLE_REFRESH_TOKEN=
# Which calendar to book into. With a service account this MUST be the shared
# calendar's id (Settings -> Integrate calendar), never "primary".
GOOGLE_CALENDAR_ID=primary

# ---- Vapi phone webhook (optional) -----------------------------
# Shared secret you set on the Vapi assistant's server URL. If set, incoming
# webhook requests must carry it in the `x-vapi-secret` header.
VAPI_SECRET=

# ---- Voice (optional, used by managed platform config only) -----
# ElevenLabs voice id for the phone agent's spoken voice.
ELEVENLABS_VOICE_ID=

# ---- Cal.com booking (only when CALENDAR=calcom) ----------------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ---- Admin dashboard --------------------------------------------
# Protects /admin and /api/admin/*. Leave empty for open access (local dev only).
ADMIN_TOKEN=

# ---- Stripe billing (optional) ----------------------------------
# From dashboard.stripe.com. Create two recurring Prices and paste their IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PORTAL_RETURN_URL=
